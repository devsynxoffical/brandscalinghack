cceed. That's why you're also getting 100% support and guidance from both myself & team.\n\nWrite \"𝐃𝐅𝐘\" below this post, and my team will reach out to see if you're a good fit!", "channel": "gauravecomm", "uploader_id": "48548887345", "uploader": "Gaurav Kapoor Ecom & Lead Gen Expert", "timestamp": 1680854187, "like_count": 1, "comment_count": 1, "http_headers": {"Referer": "https://www.instagram.com/"}, "formats": [{"format_id": "dash-155759517126879a", "ext": "m4a", "tbr": 97.114, "asr": 44100, "format_note": "DASH audio", "container": "m4a_dash", "vcodec": "none", "acodec": "mp4a.40.5", "url": "https://instagram.fskt4-1.fna.fbcdn.net/o1/v/t16/f2/m69/AQOvGW1rpnUqtSu0RNbWTMzKmRB9I1F60ftIU-Ud2EkbLXCpd4Nl4Vm60BlUh8NVtBhz1ZRZ7l_cJBAs_ZpGwZ4R.mp4?strext=1&_nc_cat=111&_nc_oc=Ado-rc8dJ5pcuQ8RAqFZpRWAPiyEWdnjkqif_JGlNCXTN0tZVhbXZfVyjxfLMeFUETI&_nc_sid=9ca052&_nc_ht=instagram.fskt4-1.fna.fbcdn.net&_nc_ohc=5ZIygIkW98IQ7kNvwGEULnQ&&ccb=17-1&_nc_gid=XWG5a3qyQTwmWwHNAeGW1Q&_nc_ss=70689&_nc_map=urlgen_bucketless&_nc_zt=28&oh=00_AQJ-JYgA42mAqGv5QnapmTwxZ8EcPkt_xIOHiFwCR4vI_Q&oe=6ABEB039", "manifest_stream_number": 0, "is_dash_periods": true, "protocol": "https", "audio_ext": "m4a", "video_ext": "none", "vbr": 0, "abr": 97.114, "resolution": "audio only", "http_headers": {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/145.0.0.0 Safari/537.36", "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8", "Accept-Language": "en-us,en;q=0.5", "Sec-Fetch-Mode": "navigate", "Referer": "https://www.instagram.com/"}, "format": "dash-155759517126879a - audio only (DASH audio)"}, {"url": "https://instagram.fskt4-1.fna.fbcdn.net/o1/v/t2/f2/m82/AQPnjtzoiyCW4vwMbK1TGLUbK_xyBW3WGI7OVE9HQHGDXHHQkQiFBfDyiRxz1a-xfRWexyvaQdar-yXnB4drfAM-QC85YQTYx0mcPqk.mp4?_nc_cat=100&_nc_oc=AdqprrCsHDZp4UqjOzjoQuNbol__vMP68lQiUTg_xCr4UikgKgPxpqLDPHyUXabOkUY&_nc_sid=5e9851&_nc_ht=instagram.fskt4-1.fna.fbcdn.net&_nc_ohc=2Eqcu-jrkoAQ7kNvwGCSp